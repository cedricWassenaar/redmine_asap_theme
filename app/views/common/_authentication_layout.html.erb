<div id="login-form"
     class="w-full h-full bg-fixed flex bg-no-repeat bg-left-top bg-cover"
     style="background-image: url(<%= asset_path("plugin_assets/redmine_asap_theme/login/#{Setting.plugin_redmine_asap_theme['redmine_asap_login_wallpaper']}") %>)">
  <div class="flex flex-col md:flex-row bg-white items-stretch justify-center
              h-auto my-auto mx-8 md:mx-auto shadow-md
              w-full md:w-4/5 lg:w-3/5 xl:w-3/5 2xl:w-2/5">
    <div class="p-8 flex items-center justify-center flex-col
                w-full md:w-2/5 bg-blue-900">

      <div class="hidden md:flex items-center justify-center">
        <%= image_tag 'redmine_white.svg',
                      plugin: 'redmine_asap_theme',
                      class: 'w-22 h-22' %>
      </div>
      <div class="text-center text-blue-100 w-full my-0 md:my-4 font-medium text-lg">
        <%= Setting.app_title %>
      </div>
    </div>
    <div class="w-full h-full md:w-3/5 flex flex-col px-12 py-8 md:py-14">
      <%= yield %>
    </div>
  </div>
</div>