<%= call_hook :view_account_login_top %>

<%= render(layout: "common/authentication_layout") do %>

  <%= form_tag(signin_path,
      onsubmit: 'return keepAnchorOnSignIn(this);',
      data: { turbo: false },
      class: "mb-6") do %>

    <%= back_url_hidden_field_tag %>

    <div class="mb-6">
      <label for="username"><%= l(:field_login) %></label>
      <%= text_field_tag 'username',
                         params[:username],
                         tabindex: '1',
                         autocomplete: 'username' %>
    </div>

    <div class="mb-6">
      <label for="password"><%= l(:field_password) %></label>

      <%= password_field_tag 'password',
                             nil,
                             tabindex: '2',
                             autocomplete: 'current-password' %>

      <%= link_to l(:label_password_lost),
                  lost_password_path,
                  class: "lost_password ml-auto text-blue-700 hover:text-blue-800 text-xs" if Setting.lost_password? %>
    </div>

    <% if Setting.autologin? %>
      <div class="mb-6">
        <label for="autologin">
          <%= check_box_tag 'autologin', 1, false %>
          <%= l(:label_stay_logged_in) %>
        </label>
      </div>
    <% end %>

    <input type="submit"
           name="login"
           value="<%= l(:button_login) %>"
           id="login-submit"
           class="w-full cursor-pointer text-white bg-blue-700 hover:bg-blue-800 rounded text-sm px-3 py-2" />

  <% end %>

  <%= call_hook :view_account_login_bottom %>

<% end %>